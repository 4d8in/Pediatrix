# URL du backend Node.js. Par défaut, le backend tourne sur la même machine que
# ce poste (Accueil/Pédiatrie/Labo).
# À adapter uniquement si ce poste tourne sur une autre machine du LAN, puis
# recompiler l'app (npm run dist) : cette valeur est résolue au build,
# pas au lancement.
VITE_BACKEND_URL=http://localhost:3001
