# Identifiants PostgreSQL - copier ce fichier en .env et adapter si besoin.
POSTGRES_DB=pediatrix_cliniqUE_123
POSTGRES_USER=pediatrix_123
POSTGRES_PASSWORD=change_me

# --- Déploiement complet (docker compose --profile full up -d) ---

# Sauvegarde automatique : fréquence (heures), nombre de sauvegardes conservées.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Phrase secrète de chiffrement des sauvegardes (AES-256). Vide = non chiffré.
# À conserver ailleurs qu'avec les sauvegardes : sans elle, elles sont illisibles.
BACKUP_PASSPHRASE=

# Profil « tls » : nom d'hôte du serveur sur le réseau local (déclaré dans le DNS local
# ou le fichier hosts des postes).
TLS_HOST=pediatrix.lan

# Avec le profil tls : 127.0.0.1 pour fermer le port 3001 au réseau (seul https://…:3443 reste ouvert).
# BACKEND_BIND=127.0.0.1
