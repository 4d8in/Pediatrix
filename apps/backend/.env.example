# URL du serveur HAPI FHIR (voir docker-compose.yml à la racine)
HAPI_FHIR_URL=http://localhost:8080/fhir

# Port d'écoute du backend
PORT=3001

# Secret de signature des JWT - générer une chaîne aléatoire longue, ne jamais
# réutiliser cette valeur d'exemple.
JWT_SECRET=change_me_generate_a_long_random_string

# Mot de passe des comptes de démonstration créés par scripts/seed-users.sh
# (un compte par rôle, voir ce script). À changer avant tout usage hors poste local.
SEED_USER_PASSWORD=change_me_1234

# Service d'agrégation (reporting) — voir CLAUDE.md, PostgreSQL "reporting".
# Chaîne de connexion postgres:// vers le PostgreSQL Supabase. Ne jamais commiter
# de valeur ici : uniquement des agrégats/compteurs sont envoyés, jamais de
# données nominatives (voir apps/backend/src/reporting/).
SUPABASE_DB_URL=

# Intervalle entre deux cycles d'agrégation, en millisecondes.
REPORTING_INTERVAL_MS=300000

# Taille (en jours) de la fenêtre récente pour les consultations par jour.
REPORTING_WINDOW_DAYS=14

# Dossier servi sur GET /updates/:file pour les mises à jour des postes
# (y copier le contenu de apps/desktop/release/ après `npm run dist`).
UPDATES_DIR=./updates
