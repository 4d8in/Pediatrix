{
  "name": "pediatrix-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "tsc && tsc -p tsconfig.node.json && vite build --mode electron",
    "dist": "npm run electron:build && electron-builder --linux",
    "dist:win": "npm run electron:build && electron-builder --win",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-plugin-electron": "^0.29.0"
  },
  "description": "Pédiatrix — poste clinique",
  "author": "Pediatrix",
  "main": "dist-electron/main.cjs",
  "homepage": "https://github.com/4d8in/Pediatrix"
}
